      // ==========================================
      // EXPORT ENGINE 3: PRINTABLE / PDF PREVIEW
      // ==========================================
      function openPrintModal() {
        const cust = getCurrentCustomer();
        if (!cust) return;

        const totalPrice = parseFloat(cust.totalPrice) || 0;
        const totalPaid = cust.payments.reduce(
          (sum, p) => sum + (parseFloat(p.amount) || 0),
          0,
        );
        const balance = totalPrice - totalPaid;

        document.getElementById("printDocDate").textContent =
          new Date().toLocaleDateString("en-GB");
        document.getElementById("printDocRef").textContent =
          cust.refNo || "2026001";
        document.getElementById("printCustRef").textContent =
          cust.refNo || "2026001";

        document.getElementById("printCustName").textContent = cust.name || "-";
        document.getElementById("printCustContact").textContent =
          cust.contact || "-";
        document.getElementById("printCustProject").textContent =
          cust.project || "-";
        document.getElementById("printCustFlat").textContent = cust.flat || "-";
        document.getElementById("printCustTotalPrice").textContent =
          totalPrice.toLocaleString("en-IN") + " BDT";
        document.getElementById("printCustAgreementDate").textContent =
          formatDisplayDate(cust.agreementDate);

        const tbody = document.getElementById("printTableBody");
        tbody.innerHTML = "";

        cust.payments.forEach((p, idx) => {
          const tr = document.createElement("tr");
          tr.innerHTML = `
                    <td class="py-2 px-3 border border-slate-200 text-center">${idx + 1}</td>
                    <td class="py-2 px-3 border border-slate-200">${formatDisplayDate(p.date)}</td>
                    <td class="py-2 px-3 border border-slate-200 font-mono font-semibold text-amber-800">${p.mrNo || "-"}</td>
                    <td class="py-2 px-3 border border-slate-200">${p.type}</td>
                    <td class="py-2 px-3 border border-slate-200">${p.chequeNo || "-"}</td>
                    <td class="py-2 px-3 border border-slate-200 text-right font-bold">${(parseFloat(p.amount) || 0).toLocaleString("en-IN")} BDT</td>
                `;
          tbody.appendChild(tr);
        });

        document.getElementById("printTotalPaid").textContent =
          totalPaid.toLocaleString("en-IN") + " BDT";
        document.getElementById("printBalanceDue").textContent =
          balance.toLocaleString("en-IN") + " BDT";

        document.getElementById("printModal").classList.remove("hidden");
      }

      function closePrintModal() {
        document.getElementById("printModal").classList.add("hidden");
      }

      function printStatementDoc() {
        window.print();
      }

      function formatDisplayDate(dateStr) {
        if (!dateStr) return "-";
        const parts = dateStr.split("-");
        if (parts.length === 3) {
          return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }
        return dateStr;
      }

      function showToast(msg) {
        const toast = document.getElementById("toast");
        document.getElementById("toast-msg").textContent = msg;
        toast.style.transform = "translateY(0)";
        setTimeout(() => {
          toast.style.transform = "translateY(-150%)";
        }, 3000);
      }
    </script>
  </body>
