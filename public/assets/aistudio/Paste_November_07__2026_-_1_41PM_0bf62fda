<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Assetted Builders Ltd. - Customer Payment Management & Statement Generator
    </title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- Google Fonts (Inter) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- External Libraries for Excel and File Export -->
    <!-- SheetJS for Excel (.xlsx) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- FileSaver.js for saving files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              navy: {
                800: "#1e293b",
                900: "#0f172a",
                950: "#020617",
              },
              gold: {
                400: "#fbbf24",
                500: "#f59e0b",
                600: "#d97706",
              },
            },
            fontFamily: {
              sans: ["Inter", "sans-serif"],
            },
          },
        },
      };
    </script>
    <style>
              body {
                  font-family: 'Inter', sans-serif;
                  background-color: #f8fafc;
              }
              @media print {

      <style>
        body {
          font-family: "Inter", sans-serif;
          background-color: #f8fafc;
        }

        .print-only {
          display: none;
        }

        @media print {
          @page {
            size: A4;
            margin: 10mm;
          }

          html,
          body {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            color: #000000 !important;
          }

          body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
          }

          body * {
            visibility: hidden;
          }

          #printableArea,
          #printableArea * {
            visibility: visible;
          }

          #printableArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
            background: #ffffff !important;
          }

          .no-print,
          #printModal .no-print,
          #paymentModal,
          #toast {
            display: none !important;
          }

          .print-only {
            display: block !important;
          }

          .print-card {
            box-shadow: none !important;
            border: none !important;
          }
        }
    </style>
  </head>
  <body
    class="text-slate-800 antialiased min-h-screen flex flex-col justify-between"
  >
    <!-- Toast Notification Box -->
    <div
      id="toast"
      class="fixed top-5 right-5 z-50 transform translate-y-[-150%] transition-transform duration-300 ease-in-out bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 border-l-4 border-gold-500"
    >
      <i
        id="toast-icon"
        class="fa-solid fa-circle-check text-gold-500 text-lg"
      ></i>
      <span id="toast-msg" class="font-medium text-sm"
        >Action completed successfully!</span
      >
    </div>

    <!-- MAIN APP WRAPPER -->
    <div class="no-print flex-1">
      <!-- Header & Branding Bar -->
      <header
        class="bg-navy-900 text-white border-b-4 border-gold-500 sticky top-0 z-30 shadow-md"
      >
        <div
          class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap justify-between items-center gap-4"
        >
          <div class="flex items-center space-x-3">
            <!-- Custom SVG Logo Matching Assetted Builders AB Brand Image -->
            <div
              class="bg-navy-950 p-2 rounded-xl border border-gold-500/30 shadow-md flex items-center justify-center w-12 h-12"
            >
              <svg
                class="w-9 h-9"
                viewBox="0 0 200 200"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <!-- Blue Peak A Left -->
                <path d="M30 160 L95 30 L120 75 L60 160 Z" fill="#1d4ed8" />
                <!-- Gray / Slate Accent Peak -->
                <path d="M95 30 L115 15 L120 75 Z" fill="#94a3b8" />
                <!-- Dark Blue Peak Center -->
                <path d="M120 15 L145 15 L145 150 L120 150 Z" fill="#0f172a" />
                <!-- Window Grid -->
                <rect x="75" y="130" width="12" height="12" fill="#1d4ed8" />
                <rect x="90" y="130" width="12" height="12" fill="#1d4ed8" />
                <rect x="75" y="145" width="12" height="12" fill="#1d4ed8" />
                <rect x="90" y="145" width="12" height="12" fill="#1d4ed8" />
                <!-- Gold B Letter Structure -->
                <path
                  d="M120 50 C165 50 185 70 185 90 C185 105 170 115 150 118 C175 122 190 135 190 155 C190 178 160 185 120 185 L120 150 C145 150 155 145 155 135 C155 125 140 120 120 120 L120 85 C140 85 150 80 150 72 C150 62 138 60 120 60 Z"
                  fill="#f59e0b"
                />
                <!-- Gold Roof Arch -->
                <path d="M25 160 L120 100 L120 120 L40 160 Z" fill="#fbbf24" />
                <!-- Outer Orbital Swooshes -->
                <path
                  d="M15 125 C 20 180, 110 195, 150 180"
                  stroke="#1d4ed8"
                  stroke-width="6"
                  stroke-linecap="round"
                />
                <path
                  d="M80 195 C 140 195, 200 165, 195 100"
                  stroke="#f59e0b"
                  stroke-width="6"
                  stroke-linecap="round"
                />
              </svg>
            </div>
            <div>
              <h1
                class="text-xl sm:text-2xl font-extrabold tracking-tight text-white flex items-center gap-2"
              >
                ASSETTED BUILDERS LTD.
                <span
                  class="text-xs bg-gold-500/20 text-gold-400 border border-gold-500/30 px-2 py-0.5 rounded-full font-semibold"
                  >ERP Suite</span
                >
              </h1>
              <p class="text-xs text-slate-300 font-medium">
                <i
                  class="fa-solid fa-location-dot text-gold-400 text-[10px] mr-1"
                ></i>
                Notun Panir pamp Road, Block# B, Sayednagar, Vatara, Gulshan,
                Dhaka-1212
                <span class="mx-1 text-slate-500">|</span>
                <i class="fa-solid fa-phone text-gold-400 text-[10px] mr-1"></i>
                +8801706-664962, +8801717-080916
              </p>
            </div>
          </div>

          <!-- Customer Selection & Search Dropdown -->
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="relative flex-1 sm:w-72">
              <select
                id="customerSelect"
                onchange="switchCustomer(this.value)"
                class="w-full bg-navy-800 text-white text-sm font-medium rounded-lg border border-slate-700 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent cursor-pointer"
              >
                <!-- Populated dynamically -->
              </select>
            </div>
            <button
              onclick="createNewCustomerPrompt()"
              class="bg-gold-500 hover:bg-gold-600 text-navy-900 font-bold px-3 py-2 rounded-lg text-sm transition-all duration-200 flex items-center gap-1.5 shadow-sm whitespace-nowrap"
            >
              <i class="fa-solid fa-user-plus"></i>
              <span class="hidden sm:inline">New Client</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Dashboard Container -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        <!-- Search & Filter Bar -->
        <div
          class="bg-white rounded-xl p-3 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center gap-3"
        >
          <div class="relative flex-1 w-full">
            <i
              class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
            ></i>
            <input
              type="text"
              id="searchInput"
              oninput="filterCustomers()"
              placeholder="Search by name, flat no, or Customer ID..."
              class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:bg-white transition-all"
            />
          </div>
          <div class="text-xs font-semibold text-slate-500 whitespace-nowrap">
            Active Customer ID:
            <span id="activeCustomerIdBadge" class="text-gold-600 font-bold"
              >2026001</span
            >
          </div>
        </div>

        <!-- Summary KPI Cards Row -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Card 1: Total Flat Price -->
          <div
            class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center justify-between relative overflow-hidden"
          >
            <div class="space-y-1">
              <p
                class="text-xs font-semibold uppercase tracking-wider text-slate-500"
              >
                Total Flat Price
              </p>
              <h3 id="cardTotalPrice" class="text-2xl font-bold text-slate-900">
                0 BDT
              </h3>
              <p
                id="cardProjectName"
                class="text-xs text-slate-500 font-medium truncate max-w-[200px]"
              >
                Project: -
              </p>
            </div>
            <div class="bg-slate-100 text-slate-700 p-3.5 rounded-xl text-xl">
              <i class="fa-solid fa-house-lock"></i>
            </div>
            <div
              class="absolute bottom-0 left-0 right-0 h-1 bg-slate-300"
            ></div>
          </div>

          <!-- Card 2: Total Paid -->
          <div
            class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center justify-between relative overflow-hidden"
          >
            <div class="space-y-1">
              <p
                class="text-xs font-semibold uppercase tracking-wider text-emerald-600"
              >
                Total Received Amount
              </p>
              <h3
                id="cardTotalPaid"
                class="text-2xl font-bold text-emerald-600"
              >
                0 BDT
              </h3>
              <p
                id="cardPaymentCount"
                class="text-xs text-slate-500 font-medium"
              >
                0 Installments Recorded
              </p>
            </div>
            <div
              class="bg-emerald-50 text-emerald-600 p-3.5 rounded-xl text-xl"
            >
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <div
              class="absolute bottom-0 left-0 right-0 h-1 bg-emerald-500"
            ></div>
          </div>

          <!-- Card 3: Balance Remaining -->
          <div
            class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center justify-between relative overflow-hidden"
          >
            <div class="space-y-1">
              <p
                class="text-xs font-semibold uppercase tracking-wider text-amber-600"
              >
                Outstanding Balance
              </p>
              <h3 id="cardBalanceDue" class="text-2xl font-bold text-amber-600">
                0 BDT
              </h3>
              <div class="flex items-center gap-2">
                <span
                  id="cardProgressText"
                  class="text-xs font-bold text-amber-700"
                  >0% Paid</span
                >
              </div>
            </div>
            <div class="bg-amber-50 text-amber-600 p-3.5 rounded-xl text-xl">
              <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div
              class="absolute bottom-0 left-0 right-0 h-1 bg-amber-500"
            ></div>
          </div>
        </div>

        <!-- Overall Progress Bar Container -->
        <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
          <div
            class="flex justify-between items-center mb-1 text-sm font-semibold"
          >
            <span class="text-slate-700">Overall Payment Completion</span>
            <span id="progressPercentageText" class="text-gold-600">0%</span>
          </div>
          <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
            <div
              id="progressBarInner"
              class="bg-gradient-to-r from-gold-500 to-emerald-500 h-3 rounded-full transition-all duration-500"
              style="width: 0%"
            ></div>
          </div>
        </div>

        <!-- 2-Column Section: Customer Info Form (Left) & Export Actions (Right) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Left Column: Customer Details Editor Form -->
          <div
            class="lg:col-span-2 bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm space-y-4"
          >
            <div
              class="flex items-center justify-between pb-3 border-b border-slate-100"
            >
              <h2
                class="text-base font-bold text-navy-900 flex items-center gap-2"
              >
                <i class="fa-solid fa-id-card text-gold-500"></i> Customer &
                Property Profile
              </h2>
              <button
                onclick="saveCustomerInfo()"
                class="text-xs bg-navy-900 hover:bg-slate-800 text-white font-semibold px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
              >
                <i class="fa-solid fa-floppy-disk"></i> Save Profile
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Customer ID</label
                >
                <input
                  type="text"
                  id="custRef"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 font-bold text-gold-600 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. 2026001"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Customer Name</label
                >
                <input
                  type="text"
                  id="custName"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. Hosneara Begum"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Contact Number</label
                >
                <input
                  type="text"
                  id="custContact"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. 01894-934665"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Project Name</label
                >
                <input
                  type="text"
                  id="custProject"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. Assetted Master Tower"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Flat / Unit No.</label
                >
                <input
                  type="text"
                  id="custFlat"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. Lift - 3A"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Total Flat Price (BDT)</label
                >
                <input
                  type="number"
                  id="custTotalPrice"
                  oninput="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 font-bold text-navy-900 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                  placeholder="e.g. 6450000"
                />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold text-slate-600 mb-1"
                  >Agreement Date</label
                >
                <input
                  type="date"
                  id="custAgreementDate"
                  onchange="saveCustomerInfo()"
                  class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-gold-500 focus:outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Right Column: Instant Document Export Actions Engine -->
          <div
            class="bg-gradient-to-br from-navy-900 to-slate-900 text-white rounded-2xl p-5 sm:p-6 border border-slate-800 shadow-md flex flex-col justify-between space-y-4"
          >
            <div>
              <div
                class="flex items-center space-x-2 border-b border-slate-800 pb-3 mb-3"
              >
                <i class="fa-solid fa-file-export text-gold-500 text-lg"></i>
                <h2 class="text-base font-bold text-white">
                  Automated Export Engine
                </h2>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                Generate formatted official documents directly in your browser
                without Excel or manual file entry.
              </p>
            </div>

            <div class="space-y-3">
              <!-- Export Excel Button -->
              <button
                onclick="exportToExcel()"
                class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 px-4 rounded-xl shadow transition-all duration-200 flex items-center justify-between text-sm group"
              >
                <span class="flex items-center gap-2">
                  <i
                    class="fa-solid fa-file-excel text-lg text-emerald-200 group-hover:scale-110 transition-transform"
                  ></i>
                  Export Excel Sheet (.xlsx)
                </span>
                <i class="fa-solid fa-download text-xs"></i>
              </button>

              <!-- Export Word Button -->
              <button
                onclick="exportToWord()"
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2.5 px-4 rounded-xl shadow transition-all duration-200 flex items-center justify-between text-sm group"
              >
                <span class="flex items-center gap-2">
                  <i
                    class="fa-solid fa-file-word text-lg text-blue-200 group-hover:scale-110 transition-transform"
                  ></i>
                  Export Word Document (.docx)
                </span>
                <i class="fa-solid fa-download text-xs"></i>
              </button>

              <!-- Printable PDF Preview Button -->
              <button
                onclick="openPrintModal()"
                class="w-full bg-gold-500 hover:bg-gold-600 text-navy-900 font-bold py-2.5 px-4 rounded-xl shadow transition-all duration-200 flex items-center justify-between text-sm group"
              >
                <span class="flex items-center gap-2">
                  <i
                    class="fa-solid fa-print text-lg text-navy-900 group-hover:scale-110 transition-transform"
                  ></i>
                  Open Print / PDF Preview
                </span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
            </div>

            <div
              class="pt-2 border-t border-slate-800 text-[11px] text-slate-400 flex justify-between items-center"
            >
              <span
                ><i class="fa-solid fa-shield-halved text-gold-500"></i> Auto
                Sync Enabled</span
              >
              <span>Assetted v3.3</span>
            </div>
          </div>
        </div>

        <!-- Payment Records History Table Section -->
        <div
          class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden"
        >
          <div
            class="p-4 sm:p-5 border-b border-slate-100 flex flex-wrap justify-between items-center gap-3"
          >
            <div>
              <h2
                class="text-base font-bold text-navy-900 flex items-center gap-2"
              >
                <i class="fa-solid fa-list-check text-gold-500"></i> Customer
                Payment Ledger History
              </h2>
              <p class="text-xs text-slate-500">
                Add, edit, or track all installments received from this
                customer.
              </p>
            </div>
            <button
              onclick="openPaymentModal()"
              class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-3.5 py-2 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm"
            >
              <i class="fa-solid fa-plus"></i> Add Payment Entry
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-700">
              <thead
                class="bg-slate-50 text-slate-600 uppercase text-[11px] font-bold tracking-wider border-b border-slate-200"
              >
                <tr>
                  <th class="py-3 px-4 w-12 text-center">#</th>
                  <th class="py-3 px-4">Payment Date</th>
                  <th class="py-3 px-4">Money Receipt No.</th>
                  <th class="py-3 px-4">Payment Method</th>
                  <th class="py-3 px-4">Cheque / Ref No</th>
                  <th class="py-3 px-4 text-right">Amount (BDT)</th>
                  <th class="py-3 px-4 text-center w-28">Actions</th>
                </tr>
              </thead>
              <tbody id="paymentTableBody" class="divide-y divide-slate-100">
                <!-- Dynamically Generated Payment Rows -->
              </tbody>
              <tfoot class="bg-slate-50 font-bold text-slate-900">
                <tr>
                  <td colspan="5" class="py-3 px-4 text-right">
                    Total Amount Received:
                  </td>
                  <td
                    id="tableTotalPaid"
                    class="py-3 px-4 text-right text-emerald-600 font-extrabold text-base"
                  >
                    0 BDT
                  </td>
                  <td></td>
                </tr>
                <tr class="border-t border-slate-200 bg-amber-50/50">
                  <td colspan="5" class="py-3 px-4 text-right text-amber-800">
                    Remaining Balance Due:
                  </td>
                  <td
                    id="tableBalanceDue"
                    class="py-3 px-4 text-right text-amber-700 font-extrabold text-base"
                  >
                    0 BDT
                  </td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </main>
    </div>

    <!-- PRINTABLE STATEMENT MODAL PREVIEW -->
    <div
      id="printModal"
      class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden overflow-y-auto"
    >
      <div
        class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden"
      >
        <!-- Modal Header -->
        <div
          class="no-print p-4 bg-navy-900 text-white flex justify-between items-center border-b border-slate-800"
        >
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-print text-gold-500"></i>
            <h3 class="font-bold text-sm sm:text-base">
              Official Customer Statement Preview
            </h3>
          </div>
          <div class="flex items-center gap-2">
            <button
              onclick="printStatementDoc()"
              class="bg-gold-500 hover:bg-gold-600 text-navy-900 font-bold text-xs px-3 py-1.5 rounded-lg flex items-center gap-1"
            >
              <i class="fa-solid fa-print"></i> Print / Download PDF
            </button>
            <button
              onclick="closePrintModal()"
              class="text-slate-400 hover:text-white p-1 rounded-lg"
            >
              <i class="fa-solid fa-xmark text-lg"></i>
            </button>
          </div>
        </div>

        <!-- Printable Sheet Content Body -->
        <div
          id="printableArea"
          class="p-8 sm:p-10 overflow-y-auto flex-1 bg-white text-slate-900 space-y-6"
        >
          <!-- Company Header -->
          <div
            class="flex justify-between items-start border-b-2 border-gold-500 pb-4"
          >
