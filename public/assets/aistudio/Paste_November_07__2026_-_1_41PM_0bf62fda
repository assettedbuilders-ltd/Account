                    .header { border-bottom: 2px solid #d97706; padding-bottom: 10px; margin-bottom: 20px; }
                    .info-table, .ledger-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 13px; }
                    .info-table td { padding: 6px; }
                    .ledger-table th { background-color: #0f172a; color: #ffffff; padding: 8px; border: 1px solid #0f172a; }
                    .summary-row { font-weight: bold; background-color: #f1f5f9; }
                </style>
                </head>
                <body>
                    <div class="header">
                        <h1>ASSETTED BUILDERS LTD.</h1>
                        <p style="color: #d97706; font-weight: bold; font-size: 12px; margin: 0;">REAL ESTATE DEVELOPMENT & HOLDINGS</p>
                        <p style="font-size: 11px; color: #334155; margin-top: 4px; margin-bottom: 2px;"><strong>Office Address:</strong> Notun Panir pamp Road, Block# B, Sayednagar, Vatara, Gulshan, Dhaka-1212</p>
                        <p style="font-size: 11px; color: #334155; margin: 0;"><strong>Cell:</strong> +8801706-664962, +8801717-080916</p>
                        <p style="font-size: 11px; color: #64748b; margin-top: 6px;">Corporate Customer Payment Statement | Customer ID: <strong>${cust.refNo || "2026001"}</strong> | Date: ${new Date().toLocaleDateString("en-GB")}</p>
                    </div>

                    <h3>Customer & Unit Information</h3>
                    <table class="info-table" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <tr>
                            <td><strong>Customer ID:</strong> ${cust.refNo || "2026001"}</td>
                            <td><strong>Customer Name:</strong> ${cust.name}</td>
                        </tr>
                        <tr>
                            <td><strong>Contact No:</strong> ${cust.contact}</td>
                            <td><strong>Project Name:</strong> ${cust.project}</td>
                        </tr>
                        <tr>
                            <td><strong>Flat / Unit No:</strong> ${cust.flat}</td>
                            <td><strong>Agreed Flat Price:</strong> ${totalPrice.toLocaleString("en-IN")} BDT</td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Agreement Date:</strong> ${cust.agreementDate}</td>
                        </tr>
                    </table>

                    <h3>Payment Installment History</h3>
                    <table class="ledger-table">
                        <thead>
                            <tr>
                                <th>SL</th>
                                <th>Date</th>
                                <th>Money Receipt No.</th>
                                <th>Type</th>
                                <th>Cheque / Ref No</th>
                                <th style="text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${rowsHtml}
                        </tbody>
                        <tfoot>
                            <tr class="summary-row">
                                <td colspan="5" style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">TOTAL RECEIVED AMOUNT:</td>
                                <td style="border: 1px solid #cbd5e1; padding: 8px; text-align: right; color: #047857;">${totalPaid.toLocaleString("en-IN")} BDT</td>
                            </tr>
                            <tr class="summary-row" style="background-color: #fef3c7;">
                                <td colspan="5" style="border: 1px solid #cbd5e1; padding: 8px; text-align: right;">NET OUTSTANDING BALANCE:</td>
                                <td style="border: 1px solid #cbd5e1; padding: 8px; text-align: right; color: #b45309;">${balance.toLocaleString("en-IN")} BDT</td>
                            </tr>
                        </tfoot>
                    </table>

                    <br/><br/>
                    <table style="width: 100%; text-align: center; font-size: 12px; margin-top: 40px;">
                        <tr>
                            <td style="width: 50%;">
                                _______________________<br/>
                                <strong>Customer Signature</strong>
                            </td>
                            <td style="width: 50%;">
                                _______________________<br/>
                                <strong>Authorized Signature</strong><br/>
                                Assetted Builders Ltd.
                            </td>
                        </tr>
                    </table>
                </body>
                </html>
            `;

        const blob = new Blob(["\ufeff", docHtml], {
          type: "application/msword",
        });

        const fileName = `Assetted_Statement_ID_${cust.refNo || "2026001"}_${cust.name.replace(/\s+/g, "_")}.doc`;
