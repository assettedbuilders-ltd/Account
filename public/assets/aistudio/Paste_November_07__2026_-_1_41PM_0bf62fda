    <!-- JavaScript Application Logic -->
    <script>
      // Sample Default Data Structure with Customer ID 2026001 and Money Receipt Numbers
      const DEFAULT_CUSTOMERS = [
        {
          id: "cust_2026001",
          refNo: "2026001",
          name: "Hosneara Begum",
          contact: "01894-934665",
          project: "Assetted Master Tower",
          flat: "Lift - 3A",
          totalPrice: 6450000,
          agreementDate: "2023-01-15",
          payments: [
            {
              id: "pay_1",
              date: "2023-01-15",
              mrNo: "MR-2026-001",
              type: "Cheque",
              chequeNo: "CQ-881230",
              amount: 1000000,
            },
            {
              id: "pay_2",
              date: "2023-05-10",
              mrNo: "MR-2026-002",
              type: "Cash",
              chequeNo: "",
              amount: 500000,
            },
            {
              id: "pay_3",
              date: "2023-09-20",
              mrNo: "MR-2026-003",
              type: "Online Transfer",
              chequeNo: "TRF-9901",
              amount: 500000,
            },
            {
              id: "pay_4",
              date: "2024-02-14",
              mrNo: "MR-2026-004",
              type: "Cheque",
              chequeNo: "CQ-104928",
              amount: 500000,
            },
            {
              id: "pay_5",
              date: "2024-08-01",
              mrNo: "MR-2026-005",
              type: "Cash",
              chequeNo: "",
              amount: 500000,
            },
            {
              id: "pay_6",
              date: "2025-01-10",
              mrNo: "MR-2026-006",
              type: "Cheque",
              chequeNo: "CQ-334102",
              amount: 500000,
            },
          ],
        },
      ];

      let customers = [];
      let currentCustomerId = "";

      window.onload = function () {
        loadDatabase();
        renderCustomerDropdown();
        if (customers.length > 0) {
          switchCustomer(customers[0].id);
        }
      };

      function loadDatabase() {
        const stored = localStorage.getItem("assetted_builders_customers");
        if (stored) {
          try {
            customers = JSON.parse(stored);
            customers.forEach((c, idx) => {
              if (!c.refNo) {
                c.refNo = String(2026001 + idx);
              }
            });
          } catch (e) {
            customers = DEFAULT_CUSTOMERS;
          }
        } else {
          customers = DEFAULT_CUSTOMERS;
          saveToLocalStorage();
        }
      }

      function saveToLocalStorage() {
        localStorage.setItem(
          "assetted_builders_customers",
          JSON.stringify(customers),
        );
      }

      function generateNextRefNo() {
        let maxRef = 2026000;
        customers.forEach((c) => {
          const num = parseInt(c.refNo, 10);
          if (!isNaN(num) && num > maxRef) {
            maxRef = num;
          }
        });
        return String(maxRef + 1);
      }

      function getCurrentCustomer() {
        return (
          customers.find((c) => c.id === currentCustomerId) || customers[0]
        );
      }

      function renderCustomerDropdown(filteredList = null) {
        const dropdown = document.getElementById("customerSelect");
        dropdown.innerHTML = "";
        const listToRender = filteredList || customers;

        if (listToRender.length === 0) {
          const opt = document.createElement("option");
          opt.textContent = "No matching customers found";
          dropdown.appendChild(opt);
          return;
        }

        listToRender.forEach((c) => {
          const opt = document.createElement("option");
          opt.value = c.id;
          opt.textContent = `Customer ID: ${c.refNo || "2026001"} | ${c.name} (${c.flat || "N/A"})`;
          dropdown.appendChild(opt);
        });
      }

      function filterCustomers() {
        const query = document
          .getElementById("searchInput")
          .value.toLowerCase()
          .trim();
        if (!query) {
          renderCustomerDropdown();
          if (currentCustomerId) {
            document.getElementById("customerSelect").value = currentCustomerId;
          }
          return;
        }

        const filtered = customers.filter(
          (c) =>
            (c.name && c.name.toLowerCase().includes(query)) ||
            (c.flat && c.flat.toLowerCase().includes(query)) ||
            (c.refNo && c.refNo.toLowerCase().includes(query)) ||
            (c.project && c.project.toLowerCase().includes(query)),
        );

        renderCustomerDropdown(filtered);
        if (filtered.length > 0) {
          switchCustomer(filtered[0].id);
        }
      }

      function switchCustomer(id) {
        currentCustomerId = id;
        document.getElementById("customerSelect").value = id;
        populateCustomerForm();
        renderPaymentTable();
        updateCalculations();
      }

      function populateCustomerForm() {
        const cust = getCurrentCustomer();
        if (!cust) return;
        document.getElementById("custRef").value = cust.refNo || "2026001";
        document.getElementById("custName").value = cust.name || "";
        document.getElementById("custContact").value = cust.contact || "";
        document.getElementById("custProject").value = cust.project || "";
        document.getElementById("custFlat").value = cust.flat || "";
        document.getElementById("custTotalPrice").value = cust.totalPrice || 0;
        document.getElementById("custAgreementDate").value =
          cust.agreementDate || "";
        document.getElementById("activeCustomerIdBadge").textContent =
          cust.refNo || "2026001";
      }

      function saveCustomerInfo() {
        const cust = getCurrentCustomer();
        if (!cust) return;

        cust.refNo =
          document.getElementById("custRef").value.trim() || "2026001";
        cust.name =
          document.getElementById("custName").value || "Unnamed Client";
        cust.contact = document.getElementById("custContact").value || "";
        cust.project = document.getElementById("custProject").value || "";
        cust.flat = document.getElementById("custFlat").value || "";
        cust.totalPrice =
          parseFloat(document.getElementById("custTotalPrice").value) || 0;
        cust.agreementDate =
          document.getElementById("custAgreementDate").value || "";

        saveToLocalStorage();
        renderCustomerDropdown();
        document.getElementById("customerSelect").value = cust.id;
        document.getElementById("activeCustomerIdBadge").textContent =
          cust.refNo;
        updateCalculations();
        showToast("Customer profile updated!");
      }

      function createNewCustomerPrompt() {
        const nextRef = generateNextRefNo();
        const name = prompt("Enter New Customer Name:", "New Customer");
        if (!name) return;

        const newCust = {
          id: "cust_" + Date.now(),
          refNo: nextRef,
          name: name,
          contact: "",
          project: "Assetted Master Tower",
          flat: "",
          totalPrice: 0,
          agreementDate: new Date().toISOString().split("T")[0],
          payments: [],
        };

        customers.push(newCust);
        saveToLocalStorage();
        renderCustomerDropdown();
        switchCustomer(newCust.id);
        showToast(`New client created with Customer ID: ${nextRef}`);
      }

      function renderPaymentTable() {
        const cust = getCurrentCustomer();
        const tbody = document.getElementById("paymentTableBody");
        tbody.innerHTML = "";

        if (!cust || !cust.payments || cust.payments.length === 0) {
          tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-8 text-center text-slate-400 font-medium italic">
                            No payment history recorded yet for this customer.
                        </td>
                    </tr>
                `;
          return;
        }

        cust.payments.forEach((p, index) => {
          const tr = document.createElement("tr");
          tr.className = "hover:bg-slate-50 transition-colors";
          tr.innerHTML = `
                    <td class="py-3 px-4 text-center font-semibold text-slate-400">${index + 1}</td>
                    <td class="py-3 px-4 font-medium">${formatDisplayDate(p.date)}</td>
                    <td class="py-3 px-4 font-mono text-xs font-semibold text-amber-700">${p.mrNo || "-"}</td>
                    <td class="py-3 px-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800">
                            ${p.type}
                        </span>
                    </td>
                    <td class="py-3 px-4 font-mono text-xs text-slate-600">${p.chequeNo || "-"}</td>
                    <td class="py-3 px-4 text-right font-bold text-slate-900">${(parseFloat(p.amount) || 0).toLocaleString("en-IN")} BDT</td>
                    <td class="py-3 px-4 text-center space-x-1">
                        <button onclick="editPaymentEntry('${p.id}')" class="p-1.5 text-slate-500 hover:text-blue-600 transition-colors" title="Edit">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button onclick="deletePaymentEntry('${p.id}')" class="p-1.5 text-slate-500 hover:text-red-600 transition-colors" title="Delete">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
          tbody.appendChild(tr);
        });
      }

      function updateCalculations() {
        const cust = getCurrentCustomer();
        if (!cust) return;

        const totalPrice = parseFloat(cust.totalPrice) || 0;
        const totalPaid = cust.payments
          ? cust.payments.reduce(
              (sum, p) => sum + (parseFloat(p.amount) || 0),
              0,
            )
          : 0;
        const balance = totalPrice - totalPaid;
        const progress =
          totalPrice > 0
            ? Math.min(Math.round((totalPaid / totalPrice) * 100), 100)
            : 0;

        document.getElementById("cardTotalPrice").textContent =
          totalPrice.toLocaleString("en-IN") + " BDT";
        document.getElementById("cardProjectName").textContent =
          "Project: " + (cust.project || "N/A");

        document.getElementById("cardTotalPaid").textContent =
          totalPaid.toLocaleString("en-IN") + " BDT";
        document.getElementById("cardPaymentCount").textContent =
          (cust.payments ? cust.payments.length : 0) + " Installments Recorded";

        document.getElementById("cardBalanceDue").textContent =
          balance.toLocaleString("en-IN") + " BDT";
        document.getElementById("cardProgressText").textContent =
          progress + "% Paid";

        document.getElementById("progressPercentageText").textContent =
          progress + "%";
        document.getElementById("progressBarInner").style.width =
          progress + "%";

        document.getElementById("tableTotalPaid").textContent =
          totalPaid.toLocaleString("en-IN") + " BDT";
        document.getElementById("tableBalanceDue").textContent =
          balance.toLocaleString("en-IN") + " BDT";
      }

      function openPaymentModal(paymentId = null) {
        document.getElementById("paymentForm").reset();
        document.getElementById("modalPaymentId").value = "";
        document.getElementById("modalPayDate").value = new Date()
          .toISOString()
          .split("T")[0];

        if (paymentId) {
          const cust = getCurrentCustomer();
          const pay = cust.payments.find((p) => p.id === paymentId);
          if (pay) {
            document.getElementById("paymentModalTitle").textContent =
              "Edit Payment Installment";
            document.getElementById("modalPaymentId").value = pay.id;
            document.getElementById("modalPayDate").value = pay.date;
            document.getElementById("modalPayMrNo").value = pay.mrNo || "";
            document.getElementById("modalPayType").value = pay.type;
            document.getElementById("modalPayCheque").value =
              pay.chequeNo || "";
            document.getElementById("modalPayAmount").value = pay.amount;
          }
        } else {
          document.getElementById("paymentModalTitle").textContent =
            "Add Payment Installment";
          const cust = getCurrentCustomer();
          if (cust && cust.payments && cust.payments.length > 0) {
            document.getElementById("modalPayMrNo").value =
              `MR-2026-00${cust.payments.length + 1}`;
          } else {
            document.getElementById("modalPayMrNo").value = "MR-2026-001";
          }
        }

        document.getElementById("paymentModal").classList.remove("hidden");
      }

      function closePaymentModal() {
        document.getElementById("paymentModal").classList.add("hidden");
      }

      function handlePaymentSubmit(e) {
        e.preventDefault();
        const cust = getCurrentCustomer();
        if (!cust) return;

        const id = document.getElementById("modalPaymentId").value;
        const date = document.getElementById("modalPayDate").value;
        const mrNo = document.getElementById("modalPayMrNo").value.trim();
        const type = document.getElementById("modalPayType").value;
        const chequeNo = document.getElementById("modalPayCheque").value.trim();
        const amount =
          parseFloat(document.getElementById("modalPayAmount").value) || 0;

        if (id) {
          const pay = cust.payments.find((p) => p.id === id);
          if (pay) {
            pay.date = date;
            pay.mrNo = mrNo;
            pay.type = type;
            pay.chequeNo = chequeNo;
            pay.amount = amount;
          }
        } else {
          cust.payments.push({
            id: "pay_" + Date.now(),
            date: date,
            mrNo: mrNo,
            type: type,
            chequeNo: chequeNo,
            amount: amount,
          });
        }

        saveToLocalStorage();
        renderPaymentTable();
        updateCalculations();
        closePaymentModal();
        showToast("Payment entry recorded successfully!");
      }

      function editPaymentEntry(id) {
        openPaymentModal(id);
      }

      function deletePaymentEntry(id) {
        if (!confirm("Are you sure you want to delete this payment record?"))
          return;
        const cust = getCurrentCustomer();
        cust.payments = cust.payments.filter((p) => p.id !== id);
        saveToLocalStorage();
        renderPaymentTable();
        updateCalculations();
        showToast("Payment record deleted!");
      }

      // ==========================================
      // EXPORT ENGINE 1: EXPORT TO EXCEL (.XLSX)
      // ==========================================
      function exportToExcel() {
        const cust = getCurrentCustomer();
        if (!cust) return;

        const totalPrice = parseFloat(cust.totalPrice) || 0;
        const totalPaid = cust.payments.reduce(
          (sum, p) => sum + (parseFloat(p.amount) || 0),
          0,
        );
        const balance = totalPrice - totalPaid;

        const excelData = [
          ["ASSETTED BUILDERS LTD."],
          [
            "OFFICE ADDRESS: Notun Panir pamp Road, Block# B, Sayednagar, Vatara, Gulshan, Dhaka-1212",
          ],
          ["CELL: +8801706-664962, +8801717-080916"],
          ["CUSTOMER PAYMENT STATEMENT & LEDGER"],
          ["Customer ID:", cust.refNo || "2026001"],
          ["Generated Date:", new Date().toLocaleDateString("en-GB")],
          [""],
          ["CUSTOMER DETAILS"],
          ["Customer ID:", cust.refNo || "2026001"],
          ["Customer Name:", cust.name],
          ["Contact Number:", cust.contact],
          ["Project Name:", cust.project],
          ["Flat / Unit No:", cust.flat],
          ["Total Flat Price:", totalPrice + " BDT"],
          ["Agreement Date:", cust.agreementDate],
          [""],
          ["PAYMENT HISTORY LEDGER"],
          [
            "SL No",
            "Date",
            "Money Receipt No.",
            "Payment Type",
            "Cheque / Ref No",
            "Amount (BDT)",
          ],
        ];

        cust.payments.forEach((p, idx) => {
          excelData.push([
            idx + 1,
            p.date,
            p.mrNo || "-",
            p.type,
            p.chequeNo || "-",
            parseFloat(p.amount) || 0,
          ]);
        });

        excelData.push([""]);
        excelData.push(["SUMMARY"]);
        excelData.push(["Total Flat Price:", totalPrice]);
        excelData.push(["Total Received Payment:", totalPaid]);
        excelData.push(["Net Outstanding Balance:", balance]);

        const ws = XLSX.utils.aoa_to_sheet(excelData);
        ws["!cols"] = [
          { wch: 8 },
          { wch: 14 },
          { wch: 20 },
          { wch: 18 },
          { wch: 22 },
          { wch: 20 },
        ];

        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Payment Statement");

        const fileName = `Assetted_Statement_ID_${cust.refNo || "2026001"}_${cust.name.replace(/\s+/g, "_")}.xlsx`;
        XLSX.writeFile(wb, fileName);
        showToast("Excel (.xlsx) statement downloaded!");
      }

      // ==========================================
      // EXPORT ENGINE 2: EXPORT TO WORD (.DOCX)
      // ==========================================
      function exportToWord() {
        const cust = getCurrentCustomer();
        if (!cust) return;

        const totalPrice = parseFloat(cust.totalPrice) || 0;
        const totalPaid = cust.payments.reduce(
          (sum, p) => sum + (parseFloat(p.amount) || 0),
          0,
        );
        const balance = totalPrice - totalPaid;

        let rowsHtml = "";
        cust.payments.forEach((p, idx) => {
          rowsHtml += `
                    <tr>
                        <td style="border: 1px solid #cbd5e1; padding: 8px; text-align: center;">${idx + 1}</td>
                        <td style="border: 1px solid #cbd5e1; padding: 8px;">${p.date}</td>
                        <td style="border: 1px solid #cbd5e1; padding: 8px; font-family: monospace;">${p.mrNo || "-"}</td>
                        <td style="border: 1px solid #cbd5e1; padding: 8px;">${p.type}</td>
                        <td style="border: 1px solid #cbd5e1; padding: 8px;">${p.chequeNo || "-"}</td>
                        <td style="border: 1px solid #cbd5e1; padding: 8px; text-align: right; font-weight: bold;">${(parseFloat(p.amount) || 0).toLocaleString("en-IN")} BDT</td>
                    </tr>
                `;
        });

        const docHtml = `
                <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
